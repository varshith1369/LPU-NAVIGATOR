{
  "name": "lpu-smart-campus-navigator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node --env-file-if-exists=.env backend/src/server.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "node scripts/build-directory.mjs && tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env backend/src/server.mjs",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.mjs",
    "db:admin": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "test": "node --test --test-concurrency=1 backend/test/*.test.mjs",
    "data:validate": "node scripts/validate-data.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-postgis": "0.2.8",
    "@vercel/functions": "^3.9.11",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "7.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.20",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "jsdom": "^29.1.1",
    "prettier": "3.9.9",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
