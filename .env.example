# Leave empty for local embedded PostgreSQL/PostGIS. Use managed Postgres in production.
DATABASE_URL=
PORT=3001
APP_ORIGIN=http://localhost:5173
# Set a cryptographically random value of at least 32 characters in production.
JWT_SECRET=
NODE_ENV=development
# Optional Python retrieval service; no model provider key is needed for grounded retrieval.
AI_SERVICE_URL=
# Optional password-reset webhook, HTTPS in production. Receives email and reset URL server-side.
RESET_DELIVERY_URL=
RESET_DELIVERY_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
